# Database (Railway provides this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini AI (get key from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Session secret (generate a random string: openssl rand -hex 32)
SESSION_SECRET=your-random-secret-here

# Tap Payments (https://developers.tap.company)
TAP_SECRET_KEY=sk_test_your_tap_secret_key
TAP_PUBLIC_KEY=pk_test_your_tap_public_key

# Subscription pricing
SUBSCRIPTION_PRICE=19.99
SUBSCRIPTION_CURRENCY=USD

# App URL (your Railway public URL, no trailing slash)
APP_URL=https://your-app.up.railway.app

# Port (Railway sets this automatically)
PORT=5000
